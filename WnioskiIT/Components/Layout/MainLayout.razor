  </defs>
</svg>

<div class="app">

  <button class="mobile-backdrop @(_menuOpen ? "show" : "")" type="button"
          aria-label="Zamknij menu" @onclick="CloseMenu"></button>

  <aside class="sidebar @(_menuOpen ? "show" : "")">
    <div class="brand">
      <div class="brand-mark"><svg class="icon"><use href="#i-file"/></svg></div>
      <div>
        <div class="brand-name">wnioski<span>IT</span></div>
        <div class="brand-subtitle">Portal obsługi IT</div>
      </div>
    </div>

    <nav class="nav" aria-label="Menu główne">
      <div class="nav-title">Menu główne</div>

      <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="CloseMenu"
               ActiveClass="active">
        <svg class="icon"><use href="#i-home"/></svg>
        <span class="nav-label">Pulpit</span>
      </NavLink>

      <NavLink class="nav-item" href="moje-wnioski" ActiveClass="active" @onclick="CloseMenu">
        <svg class="icon"><use href="#i-file"/></svg>
        <span class="nav-label">Moje wnioski</span>
        @if (_openRequestCount > 0) { <span class="nav-count">@_openRequestCount</span> }
      </NavLink>

      <button class="nav-item" type="button" @onclick="OpenNewRequest">
        <svg class="icon"><use href="#i-plus"/></svg>
        <span class="nav-label">Nowy wniosek</span>
      </button>

      <NavLink class="nav-item" href="katalog" ActiveClass="active" @onclick="CloseMenu">
        <svg class="icon"><use href="#i-grid"/></svg>
        <span class="nav-label">Katalog usług</span>
      </NavLink>

      <div class="nav-title">Zarządzanie</div>

      <NavLink class="nav-item" href="akceptacje" ActiveClass="active" @onclick="CloseMenu">
        <svg class="icon"><use href="#i-shield"/></svg>
        <span class="nav-label">Moje akceptacje</span>
        @if (_approvalCount > 0) { <span class="nav-count">@_approvalCount</span> }
      </NavLink>

      <button class="nav-item" type="button" @onclick='() => Toast.Show("Otwarto raporty i analizy")'>
        <svg class="icon"><use href="#i-grid"/></svg>
        <span class="nav-label">Raporty i analizy</span>
      </button>

      <div class="nav-title">Pomoc</div>

      <button class="nav-item" type="button" @onclick='() => Toast.Show("Otwarto bazę wiedzy")'>
        <svg class="icon"><use href="#i-help"/></svg>
        <span class="nav-label">Baza wiedzy</span>
      </button>

      <button class="nav-item" type="button" @onclick='() => Toast.Show("Service Desk: wew. 1234")'>
        <svg class="icon"><use href="#i-comment"/></svg>
        <span class="nav-label">Kontakt z IT</span>
      </button>
    </nav>

    <div class="sidebar-footer">
      <button class="profile" type="button" @onclick="ToggleUserMenu">
        <span class="avatar">JK</span>
        <span class="profile-info">
          <span class="profile-name">Jan Kowalski</span>
          <span class="profile-role">Pracownik · Wydział W2</span>
        </span>
        <svg class="icon"><use href="#i-chevron"/></svg>
      </button>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <button class="icon-button menu-button" type="button" aria-label="Otwórz menu" @onclick="OpenMenu">
        <svg class="icon"><use href="#i-menu"/></svg>
      </button>

      <div class="search" role="button" tabindex="0" aria-label="Otwórz wyszukiwanie"
           @onclick="OpenCommandPaletteAsync">
        <svg class="icon"><use href="#i-search"/></svg>
        <input type="search" placeholder="Szukaj lub wpisz polecenie…" aria-label="Szukaj" readonly/>
        <span class="search-shortcut">Ctrl K</span>
      </div>

      <div class="spacer"></div>

      <button class="icon-button" type="button" aria-label="Zmień motyw" @onclick="ToggleThemeAsync">
        <svg class="icon"><use href="@(_isDark ? "#i-sun" : "#i-moon")"/></svg>
      </button>

      <button class="icon-button" type="button" aria-label="Powiadomienia" @onclick="ToggleNotifications">
        <svg class="icon"><use href="#i-bell"/></svg>
        @if (_unreadCount > 0) { <span class="notification-dot"></span> }
      </button>

      <button class="profile desktop-profile" type="button" @onclick="ToggleUserMenu">
        <span class="avatar">JK</span>
        <span class="profile-info">
          <span class="profile-name">Jan Kowalski</span>
          <span class="profile-role">Wydział W2</span>
        </span>
      </button>
    </header>

    <div class="content">
    @Body
    </div>
  </main>
</div>

<!-- Notifications popover -->
<div class="popover @(_notificationsOpen ? "show" : "")">
  <div class="popover-header">
    <strong>Powiadomienia</strong>
    <button class="btn subtle" type="button" @onclick="MarkNotificationsReadAsync">Oznacz jako przeczytane</button>
  </div>
  @foreach (var n in _notifications)
  {
    <div class="notification">
      <span class="notification-icon @(n.IsWarning ? "warning" : "")">
        <svg class="icon"><use href="@(n.IsWarning ? "#i-warning" : "#i-check")"/></svg>
      </span>
      <div>
        <div class="notification-title">@n.Title</div>
        <div class="notification-text">@n.Text</div>
        <div class="notification-time">@FormatTimeAgo(n.CreatedAt)</div>
      </div>
    </div>
  }
</div>

<!-- User menu -->
<div class="popover user-menu @(_userMenuOpen ? "show" : "")">
  <div class="user-menu-head">
    <span class="avatar">JK</span>
    <div>
      <strong>Jan Kowalski</strong>
      <div class="profile-role">jan.kowalski@firma.pl</div>
    </div>
  </div>
  <button class="user-menu-item" type="button"
          @onclick='() => { ClosePopovers(); Toast.Show("Otwarto profil użytkownika"); }'>
    <svg class="icon"><use href="#i-person"/></svg> Profil użytkownika
  </button>
  <button class="user-menu-item" type="button"
          @onclick='() => { ClosePopovers(); Toast.Show("Otwarto ustawienia"); }'>
    <svg class="icon"><use href="#i-settings"/></svg> Ustawienia
  </button>
  <button class="user-menu-item" type="button"
          @onclick='() => { ClosePopovers(); Toast.Show("Wylogowanie — funkcja demonstracyjna"); }'>
    <svg class="icon"><use href="#i-chevron"/></svg> Wyloguj
  </button>
</div>

<RequestWizard @ref="_wizard" OnRequestCreated="RefreshCountsAsync" />
<CommandPalette @ref="_commandPalette"
                OnNavigate="HandleNavigate"
                OnOpenRequest="OpenNewRequestOfType"
                OnOpenDetails="HandleOpenDetails"
                OnToggleTheme="ToggleThemeAsync" />
<ToastNotification />

@code {
    private bool _menuOpen, _notificationsOpen, _userMenuOpen, _isDark;
    private int _unreadCount, _approvalCount, _openRequestCount;
    private List<AppNotification> _notifications = [];

    private RequestWizard? _wizard;
    private CommandPalette? _commandPalette;
    private DotNetObjectReference<MainLayout>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        _notifications = await NotificationService.GetAllAsync();
        _unreadCount = _notifications.Count(n => !n.IsRead);
        _approvalCount = await ApprovalService.GetPendingCountAsync();
        _openRequestCount = _approvalCount + 1; // demo count
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _objRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("blazorApp.init", _objRef); } catch { }
    }

    private void OpenMenu() { _menuOpen = true; ClosePopovers(); }
    private void CloseMenu() => _menuOpen = false;
    private void ClosePopovers() { _notificationsOpen = false; _userMenuOpen = false; }
    private void ToggleNotifications() { _notificationsOpen = !_notificationsOpen; _userMenuOpen = false; }
    private void ToggleUserMenu() { _userMenuOpen = !_userMenuOpen; _notificationsOpen = false; }

    private async Task MarkNotificationsReadAsync()
    {
        await NotificationService.MarkAllReadAsync();
        _unreadCount = 0;
        foreach (var n in _notifications) n.IsRead = true;
        ClosePopovers();
        Toast.Show("Powiadomienia oznaczono jako przeczytane");
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        try { await JS.InvokeVoidAsync("blazorApp.setTheme", _isDark ? "dark" : "light"); } catch { }
        Toast.Show(_isDark ? "Włączono ciemny motyw" : "Włączono jasny motyw");
    }

    private async Task OpenCommandPaletteAsync()
    {
        ClosePopovers();
        if (_commandPalette is not null) await _commandPalette.OpenAsync();
    }

    private void OpenNewRequest() { CloseMenu(); ClosePopovers(); _wizard?.Open(); }
    private void OpenNewRequestOfType(string? type) { _wizard?.Open(type); }
    private Task HandleNavigate(string _) => Task.CompletedTask;
    private Task HandleOpenDetails(string _) => Task.CompletedTask;

    private async Task RefreshCountsAsync()
    {
        _approvalCount = await ApprovalService.GetPendingCountAsync();
        StateHasChanged();
    }

    private static string FormatTimeAgo(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min temu";
        if (diff.TotalHours < 24)   return $"{(int)diff.TotalHours} godz. temu";
        return $"{(int)diff.TotalDays} dni temu";
    }

    public async ValueTask DisposeAsync() { _objRef?.Dispose(); await Task.CompletedTask; }
}
